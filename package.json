{
  "name": "token-by-token",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build --filter=web",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "content:check": "pnpm --filter @tbt/content content:check",
    "test": "turbo run test",
    "e2e": "pnpm --filter web e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm content:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
